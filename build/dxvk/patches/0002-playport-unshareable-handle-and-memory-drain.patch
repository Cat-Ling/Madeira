+      [&] (bool withinBudget) {
+        DxvkAllocationInfo info = allocationInfo;
+
+        if (withinBudget)
+          info.mode.set(DxvkAllocationMode::WithinBudget);
+
+        return create(info);
+      },
+      [&] {
+        drainPendingFrees(size());
+      });
+
+    if (unlikely(!allocation && mustSucceed))
+      throw DxvkError("DxvkMemoryAllocator: Memory allocation failed");
+
+    return allocation;
+  }
