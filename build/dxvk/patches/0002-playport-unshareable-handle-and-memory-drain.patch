+  template<typename Size, typename Create>
+  Rc<DxvkResourceAllocation> DxvkMemoryAllocator::allocateUnderPressure(
+    const DxvkAllocationInfo&         allocationInfo,
+    const Size&                       size,
+    const Create&                     create) {
+    bool mustSucceed = !allocationInfo.mode.any(
+      DxvkAllocationMode::NoFallback,
+      DxvkAllocationMode::NoAllocation,
+      DxvkAllocationMode::NoDeviceMemory);
+
