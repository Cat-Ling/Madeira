+        return offset;
+    }
 
     for (i = 0; i < elements_count; ++i)
     {
@@ -2155,9 +2256,14 @@ static bool is_type_supported_fx_2(struct hlsl_ctx *ctx, const struct hlsl_type
             break;
 
         case HLSL_CLASS_STRING:
+            return true;
+
         case HLSL_CLASS_PIXEL_SHADER:
         case HLSL_CLASS_VERTEX_SHADER:
-            return true;
+            if (fx_writer_enabled())
+                return true;
+            hlsl_fixme(ctx, loc, "Write fx 2.0 parameter class %#x.", type->class);
+            return false;
 
         case HLSL_CLASS_DEPTH_STENCIL_STATE:
         case HLSL_CLASS_DEPTH_STENCIL_VIEW:
@@ -2204,6 +2310,9 @@ static void write_fx_2_parameters(struct fx_write_context *fx)
