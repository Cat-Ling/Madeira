+/* madeira-bcd: register-target (tools/patch-wine-vkd3d-register-target.py, S.T.A.L.K.E.R. Clear Sky N8E3WW): a reservation that names a shader
+ * target, register(ps, c0) or register(ps_3_0, c0), applies only when compiling for that shader type, as Direct3D's compiler does;
+ * for another type it is ignored. Before, every such reservation was a compile error (hlsl_fixme). */
+static bool madeira_reservation_target_applies(struct hlsl_ctx *ctx, const char *target,
+        const struct vkd3d_shader_location *loc)
+{
+    static const struct
+    {
+        const char *name;
+        enum vkd3d_shader_type type;
+    }
+    types[] =
+    {
+        {"ps", VKD3D_SHADER_TYPE_PIXEL},
+        {"vs", VKD3D_SHADER_TYPE_VERTEX},
+        {"gs", VKD3D_SHADER_TYPE_GEOMETRY},
+        {"hs", VKD3D_SHADER_TYPE_HULL},
+        {"ds", VKD3D_SHADER_TYPE_DOMAIN},
+        {"cs", VKD3D_SHADER_TYPE_COMPUTE},
+    };
+    size_t len = strcspn(target, "_");
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(types); ++i)
+    {
+        if (len == 2 && !ascii_strncasecmp(target, types[i].name, 2))
+            return ctx->profile->type == types[i].type;
+    }
+    hlsl_warning(ctx, loc, VKD3D_SHADER_WARNING_HLSL_UNKNOWN_ATTRIBUTE,
+            "Unknown shader target '%s' in a register reservation; the reservation is kept.", target);
+    return true;
+}
