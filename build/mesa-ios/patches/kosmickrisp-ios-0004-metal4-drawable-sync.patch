--- a/src/kosmickrisp/vulkan/kk_wsi.c
+++ b/src/kosmickrisp/vulkan/kk_wsi.c
@@ -86,7 +86,11 @@
 kk_encode_drawable_present(VkCommandBuffer vk_cmd, void *drawable)
 {
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, vk_cmd);
    mtl_retain(drawable);
+   /* Madeira: a command buffer re-recorded before it was submitted still
+    * holds the previous drawable. */
+   if (cmd->drawable)
+      mtl_release(cmd->drawable);
    cmd->drawable = drawable;
 }
 
