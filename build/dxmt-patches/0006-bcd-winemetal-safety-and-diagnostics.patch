Port Tier 3 winemetal safety, diagnostics, and opt-in placement-heap fixes from
thebcd69/bcd-games:
  - Weak-import MTLSetShaderCachePath / MTLGetShaderCachePath in cache.c
  - Gate MADEIRA_FRAMEGEN on @available(iOS 26.0, macOS 26.0, *) at runtime
  - Log [gpu-error] diagnostics on failed Metal command buffers
  - Support opt-in madeira.cfg heap-untracked = 1 on D3D12 placement heaps

diff --git a/src/winemetal/unix/cache.c b/src/winemetal/unix/cache.c
index 4bca217..7b044cb 100644
--- a/src/winemetal/unix/cache.c
+++ b/src/winemetal/unix/cache.c
@@ -298,8 +298,12 @@ _CacheWriter_set(void *obj) {
 
 #ifndef DXMT_NO_PRIVATE_API
 
-extern void MTLSetShaderCachePath(NSString* path);
-extern NSString* MTLGetShaderCachePath();
+/* madeira-bcd: weak shader-cache SPI (thebcd69/bcd-games).
+ * Metal exports these but no header declares them. Weak, a system without them
+ * still starts the app, and the cache path is reported as not set; where they
+ * exist, the calls below are the same. */
+extern void MTLSetShaderCachePath(NSString* path) __attribute__((weak_import));
+extern NSString* MTLGetShaderCachePath() __attribute__((weak_import));
 
 int
 _WMTSetMetalShaderCachePath(void *obj) {
@@ -315,6 +319,11 @@ _WMTSetMetalShaderCachePath(void *obj) {
     return 0;
   }
 #endif
+  if (!MTLSetShaderCachePath || !MTLGetShaderCachePath) {   /* madeira-bcd: weak SPI absent on this system */
+    params->ret_success = 0;
+    [path release];
+    return 0;
+  }
   MTLSetShaderCachePath(resolved_path);
   params->ret_success = [MTLGetShaderCachePath() isEqualToString:resolved_path];
   [path release];
